generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  STAFF
}

enum Capability {
  MANAGE_STUDENT_ACCOUNTS
  REACTIVATE_STUDENT_ACCOUNTS
  MANAGE_STAFF_ACCOUNTS
  MANAGE_STAFF_CAPABILITIES
  PROCESS_REQUESTS
  MANAGE_REQUEST_CATEGORIES
  GENERATE_DOCUMENTS
  RELEASE_DOCUMENTS
  REVOKE_DOCUMENTS
  REGISTRY_IMPORT_UPLOAD
  REGISTRY_IMPORT_APPROVE
  FINANCE_IMPORT_UPLOAD
  FINANCE_IMPORT_APPROVE
  VIEW_FINANCE
  VIEW_AUDIT_LOG
  EXPORT_STUDENT_DATA
  EXPORT_REQUEST_DATA
  EXPORT_FINANCE_DATA
}

enum RequestStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  READY
  COMPLETED
  CANCELLED
}

enum DeliveryMethod {
  CAMPUS_PICKUP
  DIGITAL_DELIVERY
}

enum MessageVisibility {
  PUBLIC
  INTERNAL
}

enum PreferredLanguage {
  ENGLISH
  FRENCH
  ARABIC
}

enum AccountStatus {
  PENDING_APPROVAL
  ACTIVE
  DISABLED
}

enum AcademicYear {
  FOUNDATION
  YEAR_1
  YEAR_2
  YEAR_3
  MASTER_1
  MASTER_2
}

enum StudentRegistryStatus {
  ACTIVE
  INACTIVE
}

enum StudentRegistrySource {
  DEVELOPMENT_DEMO
  OFFICIAL_IMPORT
}

enum ImportType {
  REGISTRY
}

enum ImportBatchStatus {
  UPLOADED
  VALIDATED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  FAILED
}

enum RegistryImportRowValidation {
  VALID
  INVALID
}

enum RegistryImportOperation {
  CREATE
  UPDATE
}

enum NotificationEventType {
  LEGACY
  REQUEST_STATUS_CHANGED
  REQUEST_PUBLIC_MESSAGE_ADDED
  REQUEST_SUBMITTED
  REQUEST_CANCELLED
  DOCUMENT_RELEASED
  DOCUMENT_REVOKED
  FINANCE_BALANCE_UPDATED
}

enum FinanceEntryType {
  CHARGE
  PAYMENT
  CREDIT
  REFUND
  REVERSAL
}

enum FinanceTerm {
  ANNUAL
  SEMESTER_1
  SEMESTER_2
  SUMMER
}

enum FinanceImportBatchStatus {
  UPLOADED
  VALIDATED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  FAILED
}

enum FinanceImportRowValidation {
  VALID
  INVALID
}

enum DocumentArtifactType {
  REQUEST_FULFILMENT_CONFIRMATION
}

enum DocumentArtifactStatus {
  GENERATED
  RELEASED
  REVOKED
  SUPERSEDED
}

enum DocumentStorageProvider {
  VERCEL_BLOB
}

enum NotificationDeliveryChannel {
  EMAIL
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model User {
  id                         String                     @id @default(uuid()) @db.Uuid
  email                      String                     @unique @db.VarChar(320)
  fullName                   String                     @db.VarChar(200)
  passwordHash               String
  role                       UserRole
  status                     AccountStatus              @default(PENDING_APPROVAL)
  sessionVersion             Int                        @default(0)
  preferredLanguage          PreferredLanguage          @default(ENGLISH)
  approvedAt                 DateTime?                  @db.Timestamptz(3)
  approvedById               String?                    @db.Uuid
  disabledAt                 DateTime?                  @db.Timestamptz(3)
  disabledById               String?                    @db.Uuid
  createdAt                  DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime                   @updatedAt @db.Timestamptz(3)
  studentProfile             StudentProfile?
  statusChanges              RequestStatusHistory[]     @relation("StatusChangedBy")
  messages                   RequestMessage[]           @relation("MessageAuthor")
  notifications              Notification[]
  auditLogs                  AuditLog[]                 @relation("AuditActor")
  approvedBy                 User?                      @relation("AccountApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  disabledBy                 User?                      @relation("AccountDisabledBy", fields: [disabledById], references: [id], onDelete: Restrict)
  accountsApproved           User[]                     @relation("AccountApprovedBy")
  accountsDisabled           User[]                     @relation("AccountDisabledBy")
  studentRegistryRecord      StudentRegistry?           @relation("StudentRegistryRegistration")
  capabilityAssignments      UserCapabilityAssignment[] @relation("CapabilitySubject")
  capabilityGrants           UserCapabilityAssignment[] @relation("CapabilityGrantor")
  registryImportUploads      ImportBatch[]              @relation("RegistryImportUploader")
  registryImportReviews      ImportBatch[]              @relation("RegistryImportReviewer")
  generatedDocuments         DocumentArtifact[]         @relation("DocumentGeneratedBy")
  releasedDocuments          DocumentArtifact[]         @relation("DocumentReleasedBy")
  revokedDocuments           DocumentArtifact[]         @relation("DocumentRevokedBy")
  financeImportUploads       FinanceImportBatch[]       @relation("FinanceImportUploader")
  financeImportReviews       FinanceImportBatch[]       @relation("FinanceImportReviewer")
  financeTransactionsCreated FinanceTransaction[]       @relation("FinanceTransactionCreatedBy")
  financeTransactionsApplied FinanceTransaction[]       @relation("FinanceTransactionAppliedBy")
  financeReversals           FinanceTransaction[]       @relation("FinanceTransactionReversedBy")

  @@index([role, createdAt])
  @@index([status, role, createdAt])
  @@index([approvedById, approvedAt])
  @@index([disabledById, disabledAt])
}

model UserCapabilityAssignment {
  userId      String     @db.Uuid
  capability  Capability
  grantedById String?    @db.Uuid
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  user        User       @relation("CapabilitySubject", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  grantedBy   User?      @relation("CapabilityGrantor", fields: [grantedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([userId, capability])
  @@index([capability, userId])
  @@index([grantedById, createdAt])
}

model StudentProfile {
  id             String                 @id @default(uuid()) @db.Uuid
  userId         String                 @unique @db.Uuid
  studentNumber  String                 @unique @db.VarChar(50)
  program        String                 @db.VarChar(200)
  academicYear   AcademicYear
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @db.Timestamptz(3)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests       DocumentRequest[]
  financeAccount StudentFinanceAccount?

  @@index([program, academicYear])
}

model StudentFinanceAccount {
  id           String               @id @default(uuid()) @db.Uuid
  studentId    String               @unique @db.Uuid
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @db.Timestamptz(3)
  student      StudentProfile       @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  transactions FinanceTransaction[]

  @@index([studentId])
}

model FinanceTransaction {
  id                    String                @id @default(uuid()) @db.Uuid
  accountId             String                @db.Uuid
  entryType             FinanceEntryType
  amountMinor           BigInt                @db.BigInt
  ledgerEffectMinor     BigInt                @db.BigInt
  currency              String                @default("MAD") @db.Char(3)
  effectiveDate         DateTime              @db.Date
  postedAt              DateTime              @default(now()) @db.Timestamptz(3)
  billingPeriod         String                @db.Char(9)
  term                  FinanceTerm           @default(ANNUAL)
  sourceSystem          String                @db.VarChar(64)
  externalTransactionId String                @db.VarChar(160)
  sourceReference       String                @db.VarChar(200)
  description           String                @default("") @db.VarChar(1000)
  importBatchId         String?               @db.Uuid
  originalTransactionId String?               @unique @db.Uuid
  createdById           String                @db.Uuid
  appliedById           String                @db.Uuid
  reversedById          String?               @db.Uuid
  reversalReason        String?               @db.VarChar(1000)
  createdAt             DateTime              @default(now()) @db.Timestamptz(3)
  account               StudentFinanceAccount @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  importBatch           FinanceImportBatch?   @relation(fields: [importBatchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  originalTransaction   FinanceTransaction?   @relation("FinanceTransactionReversal", fields: [originalTransactionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reversal              FinanceTransaction?   @relation("FinanceTransactionReversal")
  createdBy             User                  @relation("FinanceTransactionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  appliedBy             User                  @relation("FinanceTransactionAppliedBy", fields: [appliedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reversedBy            User?                 @relation("FinanceTransactionReversedBy", fields: [reversedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([sourceSystem, externalTransactionId])
  @@index([accountId, postedAt, id])
  @@index([billingPeriod, effectiveDate, id])
  @@index([importBatchId, postedAt, id])
}

model FinanceImportBatch {
  id               String                   @id @default(uuid()) @db.Uuid
  status           FinanceImportBatchStatus @default(UPLOADED)
  uploaderId       String                   @db.Uuid
  reviewerId       String?                  @db.Uuid
  checksum         String                   @unique @db.Char(64)
  originalFilename String                   @db.VarChar(255)
  originalByteSize Int
  totalRows        Int
  validRows        Int
  invalidRows      Int
  rejectionReason  String?                  @db.VarChar(1000)
  failureCode      String?                  @db.VarChar(120)
  uploadedAt       DateTime                 @default(now()) @db.Timestamptz(3)
  validatedAt      DateTime?                @db.Timestamptz(3)
  submittedAt      DateTime?                @db.Timestamptz(3)
  reviewedAt       DateTime?                @db.Timestamptz(3)
  appliedAt        DateTime?                @db.Timestamptz(3)
  expiresAt        DateTime                 @db.Timestamptz(3)
  purgedAt         DateTime?                @db.Timestamptz(3)
  version          Int                      @default(0)
  updatedAt        DateTime                 @updatedAt @db.Timestamptz(3)
  uploader         User                     @relation("FinanceImportUploader", fields: [uploaderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reviewer         User?                    @relation("FinanceImportReviewer", fields: [reviewerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rows             FinanceImportRow[]
  transactions     FinanceTransaction[]

  @@index([uploaderId, uploadedAt, id])
  @@index([status, submittedAt, id])
  @@index([expiresAt, purgedAt, status])
}

model FinanceImportRow {
  id                    String                     @id @default(uuid()) @db.Uuid
  batchId               String                     @db.Uuid
  rowNumber             Int
  studentNumber         String?                    @db.VarChar(50)
  studentId             String?                    @db.Uuid
  entryType             FinanceEntryType?
  amountMinor           BigInt?                    @db.BigInt
  currency              String?                    @db.Char(3)
  effectiveDate         DateTime?                  @db.Date
  postingDate           DateTime?                  @db.Date
  billingPeriod         String?                    @db.Char(9)
  term                  FinanceTerm?
  sourceSystem          String?                    @db.VarChar(64)
  externalTransactionId String?                    @db.VarChar(160)
  sourceReference       String?                    @db.VarChar(200)
  description           String?                    @db.VarChar(1000)
  validation            FinanceImportRowValidation @default(INVALID)
  errorCodes            String[]                   @default([])
  createdAt             DateTime                   @default(now()) @db.Timestamptz(3)
  batch                 FinanceImportBatch         @relation(fields: [batchId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([batchId, rowNumber])
  @@index([batchId, validation, rowNumber])
  @@index([studentId, batchId])
}

model StudentRegistry {
  id                 String                @id @default(uuid()) @db.Uuid
  studentNumber      String                @unique @db.VarChar(50)
  fullName           String                @db.VarChar(200)
  normalizedFullName String                @db.VarChar(200)
  email              String                @unique @db.VarChar(320)
  program            String                @db.VarChar(200)
  academicYear       AcademicYear
  status             StudentRegistryStatus @default(ACTIVE)
  source             StudentRegistrySource
  registeredUserId   String?               @unique @db.Uuid
  registeredAt       DateTime?             @db.Timestamptz(3)
  createdAt          DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @db.Timestamptz(3)
  registeredUser     User?                 @relation("StudentRegistryRegistration", fields: [registeredUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
}

model ImportBatch {
  id               String              @id @default(uuid()) @db.Uuid
  type             ImportType          @default(REGISTRY)
  status           ImportBatchStatus   @default(UPLOADED)
  uploaderId       String              @db.Uuid
  reviewerId       String?             @db.Uuid
  checksum         String              @db.Char(64)
  originalFilename String              @db.VarChar(255)
  originalByteSize Int
  totalRows        Int
  validRows        Int
  invalidRows      Int
  rejectionReason  String?             @db.VarChar(500)
  failureCode      String?             @db.VarChar(120)
  uploadedAt       DateTime            @default(now()) @db.Timestamptz(3)
  validatedAt      DateTime?           @db.Timestamptz(3)
  submittedAt      DateTime?           @db.Timestamptz(3)
  reviewedAt       DateTime?           @db.Timestamptz(3)
  appliedAt        DateTime?           @db.Timestamptz(3)
  expiresAt        DateTime            @db.Timestamptz(3)
  purgedAt         DateTime?           @db.Timestamptz(3)
  version          Int                 @default(0)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)
  uploader         User                @relation("RegistryImportUploader", fields: [uploaderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reviewer         User?               @relation("RegistryImportReviewer", fields: [reviewerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rows             RegistryImportRow[]

  @@unique([type, checksum])
  @@index([uploaderId, uploadedAt, id])
  @@index([status, submittedAt, id])
  @@index([reviewerId, reviewedAt, id])
  @@index([expiresAt, purgedAt, status])
}

model RegistryImportRow {
  id                 String                      @id @default(uuid()) @db.Uuid
  batchId            String                      @db.Uuid
  rowNumber          Int
  studentNumber      String?                     @db.VarChar(50)
  fullName           String?                     @db.VarChar(200)
  normalizedFullName String?                     @db.VarChar(200)
  email              String?                     @db.VarChar(320)
  program            String?                     @db.VarChar(200)
  academicYear       AcademicYear?
  status             StudentRegistryStatus?
  operation          RegistryImportOperation?
  validation         RegistryImportRowValidation @default(INVALID)
  errorCodes         String[]                    @default([])
  createdAt          DateTime                    @default(now()) @db.Timestamptz(3)
  batch              ImportBatch                 @relation(fields: [batchId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([batchId, rowNumber])
  @@index([batchId, validation, rowNumber])
}

model RequestCategory {
  id          String            @id @default(uuid()) @db.Uuid
  name        String            @unique @db.VarChar(120)
  slug        String            @unique @db.VarChar(120)
  description String?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)
  requests    DocumentRequest[]

  @@index([isActive, name])
}

model DocumentRequest {
  id                String                 @id @default(uuid()) @db.Uuid
  referenceNumber   String                 @unique @default(dbgenerated("('REQ-'::text || lpad((nextval('document_request_reference_seq'::regclass))::text, 8, '0'::text))")) @db.VarChar(32)
  studentId         String                 @db.Uuid
  categoryId        String                 @db.Uuid
  status            RequestStatus          @default(SUBMITTED)
  deliveryMethod    DeliveryMethod
  copyCount         Int                    @default(1)
  details           String?
  createdAt         DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @db.Timestamptz(3)
  student           StudentProfile         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  category          RequestCategory        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  statusHistory     RequestStatusHistory[]
  messages          RequestMessage[]
  notifications     Notification[]
  documentArtifacts DocumentArtifact[]

  @@index([studentId, status, createdAt])
  @@index([categoryId, status, createdAt])
  @@index([status, createdAt])
}

model DocumentArtifact {
  id                     String                  @id @default(uuid()) @db.Uuid
  requestId              String                  @db.Uuid
  type                   DocumentArtifactType
  status                 DocumentArtifactStatus  @default(GENERATED)
  version                Int
  storageProvider        DocumentStorageProvider @default(VERCEL_BLOB)
  storageKey             String                  @unique @db.VarChar(300)
  filename               String                  @db.VarChar(255)
  mimeType               String                  @db.VarChar(100)
  byteSize               Int
  checksum               String                  @db.Char(64)
  generatedById          String                  @db.Uuid
  releasedById           String?                 @db.Uuid
  revokedById            String?                 @db.Uuid
  supersededByArtifactId String?                 @db.Uuid
  revocationReason       String?                 @db.VarChar(1000)
  generatedAt            DateTime                @default(now()) @db.Timestamptz(3)
  releasedAt             DateTime?               @db.Timestamptz(3)
  revokedAt              DateTime?               @db.Timestamptz(3)
  supersededAt           DateTime?               @db.Timestamptz(3)
  orphanedAt             DateTime?               @db.Timestamptz(3)
  createdAt              DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(3)
  request                DocumentRequest         @relation(fields: [requestId], references: [id], onDelete: Restrict)
  generatedBy            User                    @relation("DocumentGeneratedBy", fields: [generatedById], references: [id], onDelete: Restrict)
  releasedBy             User?                   @relation("DocumentReleasedBy", fields: [releasedById], references: [id], onDelete: Restrict)
  revokedBy              User?                   @relation("DocumentRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)
  supersededByArtifact   DocumentArtifact?       @relation("DocumentSupersession", fields: [supersededByArtifactId], references: [id], onDelete: Restrict)
  supersededArtifacts    DocumentArtifact[]      @relation("DocumentSupersession")

  @@unique([requestId, version])
  @@index([requestId, status, generatedAt])
  @@index([status, releasedAt, id])
  @@index([orphanedAt, status, id])
}

model RequestStatusHistory {
  id          String          @id @default(uuid()) @db.Uuid
  requestId   String          @db.Uuid
  fromStatus  RequestStatus?
  toStatus    RequestStatus
  changedById String?         @db.Uuid
  note        String?
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  request     DocumentRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  changedBy   User?           @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@index([changedById, createdAt])
}

model RequestMessage {
  id         String            @id @default(uuid()) @db.Uuid
  requestId  String            @db.Uuid
  authorId   String?           @db.Uuid
  visibility MessageVisibility @default(PUBLIC)
  body       String
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @db.Timestamptz(3)
  request    DocumentRequest   @relation(fields: [requestId], references: [id], onDelete: Restrict)
  author     User?             @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([requestId, visibility, createdAt])
  @@index([authorId, createdAt])
}

model Notification {
  id         String                 @id @default(uuid()) @db.Uuid
  userId     String                 @db.Uuid
  requestId  String?                @db.Uuid
  eventType  NotificationEventType  @default(LEGACY)
  eventKey   String                 @unique @db.VarChar(240)
  title      String                 @db.VarChar(200)
  body       String
  readAt     DateTime?              @db.Timestamptz(3)
  createdAt  DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime               @updatedAt @db.Timestamptz(3)
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  request    DocumentRequest?       @relation(fields: [requestId], references: [id], onDelete: SetNull)
  deliveries NotificationDelivery[]

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt, id])
  @@index([requestId, createdAt])
}

model NotificationDelivery {
  id                  String                      @id @default(uuid()) @db.Uuid
  notificationId      String                      @db.Uuid
  channel             NotificationDeliveryChannel
  status              NotificationDeliveryStatus  @default(PENDING)
  idempotencyKey      String                      @unique @db.VarChar(256)
  attemptCount        Int                         @default(0)
  nextAttemptAt       DateTime                    @default(now()) @db.Timestamptz(3)
  processingStartedAt DateTime?                   @db.Timestamptz(3)
  sentAt              DateTime?                   @db.Timestamptz(3)
  providerMessageId   String?                     @db.VarChar(200)
  errorCode           String?                     @db.VarChar(120)
  createdAt           DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                    @updatedAt @db.Timestamptz(3)
  notification        Notification                @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt, id])
  @@index([notificationId, channel])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String   @db.VarChar(120)
  entityType String   @db.VarChar(120)
  entityId   String?  @db.VarChar(120)
  metadata   Json     @default("{}") @db.JsonB
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt, id])
  @@index([entityType, createdAt, id])
  @@index([actorId, createdAt])
}
