{
  "name": "student-admin-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:check:changed": "node scripts/ci/check-changed-format.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run --exclude src/**/*.integration.test.ts",
    "preview:verify": "node scripts/preview/verify-preview-environment.mjs",
    "test:integration:postgresql": "vitest run --maxWorkers=1 --testTimeout=30000 --hookTimeout=60000 src/server/student-portal/student-portal-postgresql.integration.test.ts src/server/registry-import/registry-import-postgresql.integration.test.ts src/server/notifications/notifications-postgresql.integration.test.ts src/server/documents/documents-postgresql.integration.test.ts src/server/administration/administration-postgresql.integration.test.ts src/server/db/student-registry-demo.integration.test.ts src/server/db/database.integration.test.ts src/server/auth/registration-registry.integration.test.ts src/server/auth/package-b-postgresql.integration.test.ts src/server/auth/phase-3.integration.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:production": "node scripts/e2e/run-production-playwright.mjs",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-slot": "^1.3.0",
    "@react-pdf/renderer": "4.5.1",
    "@vercel/blob": "2.6.1",
    "argon2": "0.45.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "exceljs": "4.4.0",
    "lucide-react": "^1.25.0",
    "next": "^16.2.12",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "next": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    },
    "uuid": "11.1.1"
  }
}
